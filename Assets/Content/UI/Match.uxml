<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="hud" class="screen hud" picking-mode="Ignore">
        <ui:VisualElement name="team-ids" class="fill" picking-mode="Ignore" />
        <ui:VisualElement name="obscured" class="fill obscured" picking-mode="Ignore"/>
        <ui:VisualElement class="radar-anchor" picking-mode="Ignore"><ui:VisualElement name="radar" class="radar"><ui:VisualElement name="map-art" class="fill radar-art" picking-mode="Ignore" /></ui:VisualElement><ui:Label name="region" class="region" /></ui:VisualElement>
        <ui:VisualElement class="score-anchor" picking-mode="Ignore"><ui:VisualElement class="score-row"><ui:VisualElement name="team" class="team" /><ui:VisualElement class="score-core"><ui:Label name="clock" class="clock" /><ui:VisualElement class="score-line"><ui:Label name="our-score" class="score-ours"/><ui:Label class="score-dash" text="–"/><ui:Label name="their-score" class="score-theirs"/></ui:VisualElement></ui:VisualElement><ui:VisualElement name="rivals" class="team" /></ui:VisualElement><ui:Label name="phase" class="phase" /></ui:VisualElement>
        <ui:VisualElement name="kill-feed" class="kill-feed" picking-mode="Ignore" />
        <ui:VisualElement name="hit-confirm" picking-mode="Ignore"><ui:VisualElement class="hit-nw"/><ui:VisualElement class="hit-ne"/><ui:VisualElement class="hit-sw"/><ui:VisualElement class="hit-se"/></ui:VisualElement>
        <ui:VisualElement name="reticle" class="reticle" picking-mode="Ignore"/>
        <ui:Label name="event" class="event" picking-mode="Ignore"/>
        <ui:Label name="credits" class="credits" picking-mode="Ignore"/>
        <ui:VisualElement class="vitals" picking-mode="Ignore"><ui:VisualElement class="vital-left"><ui:Label name="hp" class="hp"/></ui:VisualElement><ui:VisualElement name="kill-medal" class="kill-medal"/><ui:VisualElement class="vital-right"><ui:Label name="armour" class="armour"/><ui:Label name="objective" class="objective"/></ui:VisualElement></ui:VisualElement>
        <ui:VisualElement class="equipment-stack" picking-mode="Ignore"><ui:VisualElement name="primary-slot" class="held-slot"><ui:Image name="primary-icon" class="held-icon"/><ui:Label name="primary-key" class="slot-key"/></ui:VisualElement><ui:VisualElement name="sidearm-slot" class="held-slot"><ui:Image name="sidearm-icon" class="held-icon"/><ui:Label name="sidearm-key" class="slot-key"/></ui:VisualElement><ui:VisualElement name="knife-slot" class="held-slot"><ui:Image name="knife-icon" class="held-icon"/><ui:Label name="knife-key" class="slot-key"/></ui:VisualElement><ui:VisualElement name="utility-slot" class="held-slot"><ui:Image name="utility-icon" class="held-icon"/><ui:Label name="utility-key" class="slot-key"/></ui:VisualElement><ui:Label name="held-name" class="held-name"/><ui:Label name="ammo" class="ammo"/></ui:VisualElement>
        <ui:Label name="action" class="action" picking-mode="Ignore"/>
        <ui:VisualElement name="wound" class="wound" picking-mode="Ignore"/>
        <ui:Button name="open-shop" class="buy-key" text="B   购买装备"/>
        <ui:VisualElement name="shop" class="shop"><ui:VisualElement class="sheet-heading"><ui:Label class="section-heading" text="购买装备"/><ui:Button name="close-shop" text="关闭  B" class="quiet-button"/></ui:VisualElement><ui:Label name="shop-keys" class="shop-keys" /><ui:ScrollView name="offers" /><ui:VisualElement name="protection-offers" class="protection-offers offers" /></ui:VisualElement>
        <ui:VisualElement name="menu" class="pause">
            <ui:Label name="pause-title" class="section-heading"/>
            <ui:Label name="room-feedback" picking-mode="Ignore"/>
            <ui:Button name="resume" text="继续比赛"/>
            <ui:Button name="restart" text="重新开赛"/>
            <ui:Button name="to-lobby" text="返回大厅"/>
            <ui:Button name="end-room" text="结束小队房间并返回"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
