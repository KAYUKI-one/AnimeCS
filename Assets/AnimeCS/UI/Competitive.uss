.screen { flex-grow:1; overflow:hidden; color:rgb(241,241,232); font-size:16px; }
.fill { position:absolute; left:0; top:0; right:0; bottom:0; }
.lobby { background-color:rgba(0,0,0,0); }
.lobby-stage { position:absolute; left:13%; right:3%; top:6%; height:82px; }
.wordmark { color:rgb(249,248,226); font-size:48px; -unity-font-style:bold-and-italic; }
.stage-caption { font-size:17px; color:rgb(236,225,164); }
.nav-rail { position:absolute; left:0; top:0; bottom:0; width:9%; background-color:rgba(18,26,29,.87); border-right-width:1px; border-color:rgba(200,202,177,.4); }
.nav-group { position:absolute; left:0; right:0; top:24%; bottom:10%; justify-content:space-around; }
Button { border-width:0; border-radius:2px; margin:0; padding:5px 12px; background-color:rgb(60,70,70); color:rgb(245,244,232); font-size:16px; }
Button:hover { background-color:rgb(81,91,87); }
.nav { height:19%; min-height:28px; margin-right:5%; padding-left:9%; border-radius:0; -unity-text-align:middle-left; font-size:17px; background-color:rgb(52,62,64); border-left-width:3px; border-left-color:rgb(151,151,119); }
.nav:hover, .nav.active { background-color:rgb(79,85,73); border-left-color:rgb(245,216,112); }
.settings { position:absolute; top:5%; left:0; width:76%; height:7%; font-size:16px; background-color:rgba(45,54,55,.8); }
.start,.start:hover { background-color:rgb(239,212,106); color:rgb(35,39,35); border-color:rgb(255,234,153); -unity-font-style:bold; }
.lobby-page { position:absolute; left:9%; right:0; top:0; bottom:0; background-color:rgb(28,37,40); }
.page-heading { height:9%; min-height:42px; max-height:68px; padding:0 4%; background-color:rgb(31,40,43); border-bottom-width:1px; border-bottom-color:rgb(89,96,91); }
.page-body { flex-direction:row; flex-grow:1; min-height:0; }
.lobby-page .sheet-content { flex-grow:1; flex-basis:0; padding:12px 3% 12px 4%; }
.lobby-page.equipment-page, .lobby-page.inspect-page { background-color:rgba(0,0,0,0); }
.equipment-page .sheet-content { flex-grow:0; flex-basis:31%; background-color:rgba(26,35,38,.97); padding:10px 12px; }
.video-field { max-width:640px; min-height:30px; margin:3px 0; }
.video-field Label { color:rgb(235,237,226); }
.video-field .unity-base-popup-field__input, .video-field .unity-text-field__input, .video-field .unity-base-text-field__input,
.setting-field .unity-text-field__input, .setting-field .unity-base-text-field__input {
    background-color:rgb(54,66,69); color:rgb(248,246,228); border-color:rgb(101,115,116);
}
.video-field .unity-base-popup-field__text, .video-field .unity-text-element--inner-input-field,
.setting-field .unity-text-element--inner-input-field { color:rgb(248,246,228); }
.video-readout { min-width:172px; margin-right:12px; -unity-text-align:middle-left; color:rgb(227,211,153); }
.loadout-pane { display:none; flex-grow:0; flex-basis:20%; background-color:rgba(26,35,38,.95); }
.equipment-page .loadout-pane { display:flex; }
.loadout-slots { flex-grow:1; flex-basis:0; min-height:0; padding:7px 6px; }
.turn-hint { display:none; position:absolute; bottom:8px; align-self:center; color:rgb(220,225,214); font-size:12px; padding:3px 8px; background-color:rgba(22,30,32,.68); }
.equipment-page .turn-hint { display:flex; }
.screen .unity-scroller--vertical { width:8px; min-width:8px; margin-left:4px; background-color:rgb(35,45,48); }
.screen .unity-scroller__low-button, .screen .unity-scroller__high-button { display:none; }
.screen .unity-scroller--vertical .unity-base-slider__tracker { border-width:0; background-color:rgb(39,49,51); }
.screen .unity-scroller--vertical .unity-base-slider__dragger { min-width:6px; width:6px; border-width:0; background-color:rgb(110,123,120); }
.equipment-page .subhead { margin-top:5px; margin-bottom:6px; }
.mount-slot { flex-direction:row; align-items:center; padding:4px 5px; margin-bottom:3px; border-left-width:2px; border-left-color:rgba(210,220,214,.2); background-color:rgba(63,76,77,.58); min-height:31px; }
.mount-slot.selected { border-left-color:rgb(239,210,105); background-color:rgb(75,81,66); }
.mount-slot Image { width:29px; height:27px; margin-right:6px; }
.mount-slot Label { -unity-text-align:middle-left; font-size:13px; white-space:normal; }
.slot-kind { color:rgb(235,224,171); }
.equipment-page .item-tile { flex-grow:0; min-height:62px; margin-right:2%; margin-bottom:5px; }
.loadout-controls { flex-direction:row; flex-shrink:0; flex-wrap:wrap; padding:6px; background-color:rgb(32,42,45); }
.loadout-controls Button { flex-grow:1; margin:2px; padding:5px 3px; font-size:13px; }
.bag-title { font-size:20px; -unity-font-style:bold; margin-bottom:10px; }
.compact .nav-rail { width:11%; } .compact .lobby-page { left:11%; }
.compact .equipment-page .loadout-pane { flex-basis:25%; }
.compact .equipment-page .sheet-content { flex-basis:33%; padding-left:6px; padding-right:6px; }
.compact .mount-slot { min-height:24px; padding:2px; }
.compact .mount-slot Image { width:20px; height:20px; }
.compact .nav { padding-left:4px; font-size:13px; }
.inspection-stage { flex-grow:1; }
.inspect-caption { position:absolute; left:0; right:0; bottom:0; height:38px; padding:5px 4%; background-color:rgba(24,32,34,.88); }
.inspect-page .inspection-stage { margin-bottom:38px; }
.inventory-grid .item-tile { width:18.5%; min-height:100px; margin-right:1.4%; margin-bottom:12px; background-color:rgb(45,55,59); border-bottom-width:2px; border-bottom-color:rgb(113,116,98); }
.inventory-grid .item-tile:hover { background-color:rgb(62,72,74); border-bottom-color:rgb(232,209,133); }
.inventory-grid .item-tile Image { height:68px; }
.compact .inventory-grid .item-tile { width:23%; min-height:72px; }
.compact .inventory-grid .item-tile Image { height:47px; }
.equipment-page .item-tile { width:45%; }
.shop-keys { font-size:13px; color:rgb(215,208,185); margin-bottom:8px; }
.offers Button.shop-focus { border-left-width:3px; border-left-color:rgb(248,218,121); background-color:rgb(91,91,66); }
.sheet-heading { flex-direction:row; align-items:center; justify-content:space-between; margin-bottom:12px; }
.section-heading { font-size:25px; -unity-font-style:bold; color:rgb(248,237,192); }
.sheet-content { flex-grow:1; }
.quiet-button { font-size:14px; padding:3px 9px; }
.choice-row { flex-direction:row; flex-wrap:wrap; margin-bottom:12px; }
.choice-row Button { margin-right:7px; margin-bottom:5px; }
.subhead { color:rgb(222,210,157); font-size:16px; margin-top:10px; margin-bottom:6px; }
.selected,.chosen { background-color:rgb(124,108,52); }
.setting-field { max-width:480px; margin:8px 0; }
.hud { color:white; }
.teammate-id { position:absolute; translate:-50% -100%; font-size:15px; -unity-font-style:bold;
    -unity-text-align:middle-center; color:rgb(174,236,242); -unity-text-outline-width:1px;
    -unity-text-outline-color:rgba(9,22,27,.94); text-shadow:0 1px 2px rgba(0,0,0,.9); white-space:nowrap; }
.compact .teammate-id { font-size:13px; }
.obscured { background-color:rgb(119,130,133); }
.obscured.flash { background-color:rgb(249,247,236); }
.radar-anchor { position:absolute; left:2.1%; top:4%; width:14%; align-items:center; }
.radar { width:100%; aspect-ratio:1; overflow:hidden; border-radius:1000px; border-width:2px; border-color:rgba(225,203,133,.85); background-color:rgba(29,34,34,.91); }
.radar-art { -unity-background-scale-mode:stretch-to-fill; }
.radar-dot,.radar-site { position:absolute; translate:-50% -50%; -unity-text-align:middle-center; }
.radar-dot { width:7px; height:7px; border-radius:5px; background-color:rgb(107,202,211); }
.radar-dot.enemy { background-color:rgb(241,128,103); }.radar-dot.me { width:12px; height:12px; border-radius:2px; color:rgb(255,221,113); background-color:rgba(0,0,0,0); font-size:14px; -unity-font-style:bold; }
.radar-site { color:rgb(250,221,121); font-size:12px; -unity-font-style:bold; }.region { color:rgb(246,220,132); -unity-font-style:bold; margin-top:3px; }
.score-anchor {position:absolute;left:18%; right:18%; top:2%;align-items:center; }
.score-row,.team,.score-line,.vitals,.offers { flex-direction:row; align-items:center; }
.team { justify-content:center; }
.avatar { width:28px; height:29px; margin:0 1px; border-bottom-width:3px; border-bottom-color:rgb(112,191,204); background-color:rgb(68,85,89); -unity-background-scale-mode:scale-and-crop; }
.avatar.foe { border-bottom-color:rgb(228,198,116); background-color:rgb(110,96,65); }.avatar.out { opacity:.36; }
.score-core { min-width:62px; margin:0 3px; align-items:center; background-color:rgba(19,24,23,.78); }.clock { font-size:17px; -unity-font-style:bold; }.score-line { justify-content:center; }.score-ours,.score-theirs { font-size:18px; -unity-font-style:bold; }.score-ours{color:rgb(152,218,227);}.score-theirs{color:rgb(246,217,137);}.score-dash{margin:0 4px;}
.phase,.action,.event,.region,.equipment-stack Label,.credits,.vitals Label { -unity-text-outline-width:1px; -unity-text-outline-color:rgba(15,22,22,.9); }
.phase { font-size:13px; color:rgb(244,231,181); }.reticle { position:absolute; left:50%;top:50%;width:0;height:0; }
.reticle VisualElement {background-color:rgb(157,238,160);position:absolute;}
.ret-l { left:-8px; top:-1px; width:5px; height:2px; }.ret-r {left:3px;top:-1px;width:5px;height:2px;}
.ret-t {top:-8px;left:-1px;width:2px;height:5px;}.ret-b {top:3px;left:-1px;width:2px;height:5px;}
.credits {position:absolute;bottom:3.5%;left:2.3%;color:rgb(253,221,145);font-size:24px;-unity-font-style:bold;}
.vitals {position:absolute;bottom:2%;left:25%;right:25%;justify-content:center;}
.vital-left,.vital-right { flex-basis:0; flex-grow:1; flex-direction:row; align-items:center; }
.vital-left { justify-content:flex-end; padding-right:12px; }
.vital-right { justify-content:flex-start; padding-left:12px; }
.kill-medal { width:46px; height:46px; flex-shrink:0; }
.kill-feed { position:absolute; top:8%; right:1.7%; max-width:43%; align-items:flex-end; }
.kill-row { flex-direction:row; align-items:center; background-color:rgba(16,24,27,.89); margin-bottom:3px; padding:3px 7px; border-left-width:2px; border-left-color:rgb(116,127,126); }
.kill-row.own-kill { border-left-color:rgb(246,207,111); }
.kill-row.own-death { border-left-color:rgb(226,131,110); }
.kill-player { max-width:100px; color:rgb(239,170,136); font-size:14px; white-space:nowrap; text-overflow:ellipsis; overflow:hidden; }
.kill-player.kill-ally { color:rgb(150,209,222); }
.kill-glyph { width:42px; height:17px; margin-left:6px; -unity-background-image-tint-color:rgb(225,228,213); }
.kill-tool { color:rgb(220,224,216); font-size:11px; margin-left:3px; margin-right:6px; }
.kill-tags { color:rgb(253,216,128); font-size:12px; margin-right:6px; }
.compact .kill-feed { top:13%; }
.compact .kill-player { max-width:66px;font-size:12px; }
.compact .kill-glyph { width:30px; }
.hp {font-size:26px;-unity-font-style:bold;}.armour,.objective { margin-left:12px;color:rgb(242,223,162);font-size:16px; }
.equipment-stack { position:absolute;right:2.2%;bottom:3%;align-items:flex-end;}.equipment-stack Label {font-size:14px;color:rgb(221,221,207);}.equipment-stack .equipped {color:rgb(255,222,139);-unity-font-style:bold;}.equipment-stack .ammo {font-size:24px;color:white;-unity-font-style:bold;margin-top:4px;}
.event {position:absolute; left:2.3%;bottom:21%;font-size:14px;color:rgb(230,223,194);}.action {position:absolute;left:22%;right:22%;bottom:11%;-unity-text-align:middle-center;color:rgb(255,228,150);}
.wound {position:absolute;left:0;right:0;top:0;bottom:0;border-width:4px;border-color:rgba(235,103,79,.79);}
.buy-key {position:absolute;left:2.3%;bottom:10%;background-color:rgba(24,32,31,.86);color:rgb(248,226,147);}
.shop,.pause {position:absolute; top:50%;left:50%;translate:-50% -50%;width:54%;max-height:78%;padding:16px 21px;background-color:rgba(21,29,31,.97);border-top-width:2px;border-color:rgb(234,209,121);}
.shop { left:18%; top:10%; translate:0 0; width:54%; max-height:80%; background-color:rgba(24,32,34,.94); }
.compact .shop { width:66%; left:14%; }
.shop .shop-weapon { width:23.2%; min-width:65px; flex-direction:column; align-items:stretch; padding:3px 5px; }
.shop-weapon Image { height:30px; align-self:stretch; -unity-background-image-tint-color:rgb(189,199,194); }
.offer-caption { flex-direction:row; align-items:center; justify-content:space-between; }
.offer-caption Label { font-size:12px; white-space:nowrap; }
.offer-price { color:rgb(228,211,155); }
.protection-offers { border-top-width:1px; border-color:rgb(91,102,99); padding-top:5px; margin-top:5px; flex-shrink:0; }
.compact .shop-weapon Image { height:22px; }
.compact .offer-caption Label { font-size:10px; }
.offers { flex-wrap:wrap; }.offers Button { font-size:14px;margin:2px 5px 3px 0; }.offers Button:disabled { opacity:.48; }.pause {width:260px;}.pause Button {margin-top:6px;}
.compact .avatar {width:19px;height:21px;}.compact .wordmark {font-size:32px;}
.wardrobe-tabs { border-bottom-width:1px; border-color:rgba(151,160,148,.45); padding-bottom:6px; }
.item-tile { width:30%; min-height:56px; padding:5px; flex-direction:column; align-items:center; justify-content:center; }
.item-tile Image { width:100%; height:48px; }
.item-tile Label { font-size:13px; -unity-text-align:middle-center; white-space:normal; }
.try-on { padding-top:11px; margin-top:10px; border-top-width:1px; border-color:rgba(151,160,148,.45); }
.held-slot { flex-direction:row; align-items:center; justify-content:flex-end; height:24px; margin:1px 0; }
.held-slot.equipped { height:33px; }
.held-icon { width:60px; height:23px; -unity-background-scale-mode:scale-to-fit; }
.equipped .held-icon { width:77px; height:32px; }
.equipment-stack .slot-key { min-width:16px; margin-left:4px; font-size:13px; color:white; -unity-text-align:middle-right; }
.equipment-stack .held-name { color:rgb(249,231,183);font-size:14px; -unity-text-outline-width:.35px; text-shadow:0 1px 3px rgba(0,0,0,.95); }
.equipment-stack .ammo { -unity-text-outline-width:.4px;text-shadow:0 1px 3px rgba(0,0,0,.85); }
